# Zalo Mini App config
APP_ID=your_app_id
ZMP_TOKEN=your_zmp_token

# Supabase config (Nếu dùng Supabase trực tiếp trên Zalo)
VITE_SUPABASE_URL=https://<your-id>.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Cấu hình chuyển qua dùng Backend Máy trạm
VITE_USE_LOCAL_BACKEND=true
VITE_LOCAL_API_URL=http://192.168.0.40:3000/api
