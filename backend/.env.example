# Cấu hình Database MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=lich_cup_dien_db

# Cấu hình Server Port
PORT=3000

# Cấu hình đồng bộ từ Supabase (cronjob)
SUPABASE_URL=https://<id-cua-ban>.supabase.co
SUPABASE_KEY=<chuoi-anon-key-cua-ban>

# API Key lấy thời tiết (OpenWeatherMap) nếu cần
OPENWEATHER_API_KEY=your_openweather_api_key_here
